# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant_API_Version = "2"
Vagrant.configure(Vagrant_API_Version) do |config|

  #================#
  # Ansible Server #
  #================#
  
  config.vm.define "ansible-server24" do |cfg|
    cfg.vm.box = "centos/7"
    cfg.vm.box_url = "https://box.kuberneteslab.dev/centos/7"
 	cfg.vm.provider "virtualbox" do |vb|
	  vb.name = "Ansible-Server2.4(github_SysNet4Admin)"
	end
	cfg.vm.host_name = "ansible-server24"
	cfg.vm.network "public_network", ip: "192.168.1.24"
	cfg.vm.network "forwarded_port", guest: 22, host: 60024, auto_correct: true, id: "ssh"
	cfg.vm.synced_folder "../data", "/vagrant", disabled: true
	cfg.vm.provision "shell", path: "vault_repo_4_CentOS.sh"
	# CentOS 7.9에는 ansible 패키지가 없다. 강의와 같은 2.4(extras의 2.4.2)를 보관본에서 설치한다
	cfg.vm.provision "shell", inline: "yum install -y https://vault.centos.org/7.6.1810/extras/x86_64/Packages/ansible-2.4.2.0-2.el7.noarch.rpm"
	cfg.vm.provision "file", source: "ansible_env_ready.yml", 
	  destination: "ansible_env_ready.yml"
	cfg.vm.provision "shell", inline: "ansible-playbook ansible_env_ready.yml"
  end
  
  config.vm.define "ansible-server25" do |cfg|
    cfg.vm.box = "centos/7"
    cfg.vm.box_url = "https://box.kuberneteslab.dev/centos/7"
 	cfg.vm.provider "virtualbox" do |vb|
	  vb.name = "Ansible-Server2.5(github_SysNet4Admin)"
	end
	cfg.vm.host_name = "ansible-server25"
	cfg.vm.network "public_network", ip: "192.168.1.25"
	cfg.vm.network "forwarded_port", guest: 22, host: 60025, auto_correct: true, id: "ssh"
	cfg.vm.synced_folder "../data", "/vagrant", disabled: true
	cfg.vm.provision "shell", path: "vault_repo_4_CentOS.sh"
	cfg.vm.provision "shell", inline: "yum install epel-release -y"
	# EPEL의 ansible은 2.9라서 강의와 같은 2.5(2.5.15)를 설치한다. 2.9에서는 nxos_config의 save가 없고
	# tftp 백업에 쓰는 ansible_all_ipv4_addresses가 정의되지 않는다
	cfg.vm.provision "shell", inline: "yum install -y https://releases.ansible.com/ansible/rpm/release/epel-7-x86_64/ansible-2.5.15-1.el7.ans.noarch.rpm"
	cfg.vm.provision "file", source: "ansible_env_ready.yml", 
	  destination: "ansible_env_ready.yml"
	cfg.vm.provision "shell", inline: "ansible-playbook ansible_env_ready.yml"
  end
end
